{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "audio:umea": "node --env-file=.env.local scripts/generate-umea-audio.mjs",
    "audio:stavanger": "node --env-file=.env.local scripts/generate-stavanger-audio.mjs",
    "audio:hamburg": "node --env-file=.env.local scripts/generate-hamburg-audio.mjs",
    "content:barcelona": "node scripts/parse-tour-content.mjs barcelona",
    "route:barcelona": "node scripts/print-tour-route.mjs barcelona",
    "audio:barcelona": "node --env-file=.env.local scripts/generate-tour-audio.mjs barcelona",
    "content:zurich-city-tour": "node scripts/parse-tour-content.mjs zurich-city-tour",
    "route:zurich-city-tour": "node scripts/print-tour-route.mjs zurich-city-tour",
    "audio:zurich-city-tour": "node --env-file=.env.local scripts/generate-tour-audio.mjs zurich-city-tour"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "mapbox-gl": "^3.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@elevenlabs/elevenlabs-js": "^2.75.0",
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
