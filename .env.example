# Supabase (Project Settings → API). Both values are public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mapbox public token (pk.…) — restrict it to your domains in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=

# Secret keys do NOT go here. Set them on Supabase:
#   supabase secrets set ANTHROPIC_API_KEY=… ELEVENLABS_API_KEY=… ELEVENLABS_VOICE_ID=…
